<!-- TITLE (WAVE BAND) -->
<section>
<div style="max-width: 1440px; margin: 0 auto; padding: 140px clamp(20px, 4vw, 56px) 40px; display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-end">
<div style="flex: 1 1 240px">
<div class="ld" style="font-size: 11px; letter-spacing: 0.16em; color: #4E6B78">SERVICE</div>
<h1 class="ld d1" style="margin: 12px 0 0; font-family: 'Noto Serif TC', serif; font-size: 40px; font-weight: 400; letter-spacing: 0.12em; line-height: 1.4">{{ service.title }}</h1>
</div>
<p class="ld d2" style="flex: 3 1 560px; min-width: 0; max-width: 760px; margin: 0; font-size: 14px; line-height: 2.2; color: #23404D">{{ service.lead }}</p>
</div>
</section>
<!-- SERVICES DETAIL -->
<section style="max-width: 1440px; margin: 0 auto; padding: 140px clamp(20px, 4vw, 56px) 60px">
{%- for it in service.services %}
<div class="rv" style="position: relative; display: flex; flex-wrap: wrap; gap: 32px 40px; padding: 24px 0 100px">
<div class="m-ln" style="position: absolute; top: 0; left: 0; right: 0; height: 1px; background: #CFE2EA"></div>
<div style="flex: 1 1 240px; display: flex; flex-direction: column; gap: 2px">
<span style="font-size: 11px; color: #5F7C88; letter-spacing: 0.14em">{{ loop.index | pad2 }}</span>
<h2 style="margin: 0; font-size: 12px; font-weight: 500; letter-spacing: 0.16em">{{ it.name_en }}</h2>
<span style="font-size: 12px; color: #4E6B78">{{ it.name_zh }}</span>
</div>
<div style="flex: 3 1 560px; min-width: 0; display: flex; flex-wrap: wrap; gap: 32px 48px">
<div class="m-zm" style="flex: 1 1 300px; aspect-ratio: 4 / 3; background: #E3F1F8"><img src="{{ it.image }}" alt="{{ it.name_en }}" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block"></div>
<div style="flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
<p style="margin: 0; font-family: 'Noto Serif TC', serif; font-size: 20px; line-height: 1.9; letter-spacing: 0.08em">{{ it.headline }}</p>
<p style="margin: 0; font-size: 13px; line-height: 2.1; color: #2F4B58">{{ it.body }}</p>
<div>
<div style="font-size: 11px; color: #5F7C88; letter-spacing: 0.14em; padding-bottom: 8px; border-bottom: 1px solid #E0EDF2">DELIVERABLES</div>
<ul style="margin: 8px 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; font-size: 12px; line-height: 2.2; color: #2F4B58">
{%- for x in it.deliverables %}
<li>— {{ x }}</li>
{%- endfor %}
</ul>
</div>
<div style="font-size: 12px; color: #4E6B78; line-height: 2">{% if it.cases %}<span style="font-size: 11px; color: #2A7698; letter-spacing: 0.14em">CASE　</span>{{ it.cases }}{% endif %}</div>
</div>
</div>
</div>
{%- endfor %}
</section>
{% include "partials/process.njk" %}
<!-- ENGAGEMENT -->
<section style="max-width: 1440px; margin: 0 auto; padding: 140px clamp(20px, 4vw, 56px) 140px">
<div class="rv" style="position: relative; display: flex; flex-wrap: wrap; gap: 32px 40px; padding-top: 24px">
<div class="m-ln" style="position: absolute; top: 0; left: 0; right: 0; height: 1px; background: #CFE2EA"></div>
<div style="flex: 1 1 240px; display: flex; flex-direction: column; gap: 2px">
<h2 style="margin: 0; font-size: 12px; font-weight: 500; letter-spacing: 0.16em">ENGAGEMENT</h2>
<span style="font-size: 12px; color: #4E6B78">合作形式</span>
</div>
<div style="flex: 3 1 560px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 0 32px">
{%- for e in service.engagement %}
<div class="m-row" style="padding: 24px 0 32px; border-bottom: 1px solid #E0EDF2; display: flex; flex-direction: column; gap: 8px">
<span style="font-family: 'Noto Serif TC', serif; font-size: 18px; letter-spacing: 0.1em">{{ e.name }}</span>
<span style="font-size: 11px; color: #2A7698; letter-spacing: 0.14em">{{ e.en }}</span>
<p style="margin: 6px 0 0; font-size: 13px; line-height: 2; color: #2F4B58">{{ e.desc }}</p>
</div>
{%- endfor %}
</div>
</div>
</section>
<!-- FAQ -->
<section style="max-width: 1440px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 56px) 140px">
<div class="rv" style="position: relative; display: flex; flex-wrap: wrap; gap: 32px 40px; padding-top: 24px">
<div class="m-ln" style="position: absolute; top: 0; left: 0; right: 0; height: 1px; background: #CFE2EA"></div>
<div style="flex: 1 1 240px; display: flex; flex-direction: column; gap: 2px">
<h2 style="margin: 0; font-size: 12px; font-weight: 500; letter-spacing: 0.16em">FAQ</h2>
<span style="font-size: 12px; color: #4E6B78">常見問題</span>
</div>
<div style="flex: 3 1 560px; min-width: 0">
{%- for f in service.faq %}{% if f.q and f.a %}
<details class="fq" style="border-bottom: 1px solid #E0EDF2">
<summary style="font-size: 14px; letter-spacing: 0.06em; padding: 24px 0; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; color: #12303F">
<span><span style="color: #2A7698; margin-right: 12px">Q.</span>{{ f.q }}</span>
<span class="fqs" style="font-size: 18px; line-height: 1; color: #4E6B78">+</span>
</summary>
<p class="pnl" style="margin: 0; padding: 0 0 24px 28px; font-size: 13px; line-height: 2.1; color: #2F4B58">{{ f.a }}</p>
</details>
{%- endif %}{% endfor %}
</div>
</div>
</section>
<!-- CONTACT -->
<section id="contact" class="wv">
<div class="rv" style="max-width: 1440px; margin: 0 auto; padding: 160px clamp(20px, 4vw, 56px) 160px; display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-end; justify-content: space-between">
<div style="flex: 3 1 560px; min-width: 0">
<div style="font-size: 11px; letter-spacing: 0.16em; color: #23404D; margin-bottom: 32px">CONTACT ／ 聯絡</div>
<p style="margin: 0; font-family: 'Noto Serif TC', serif; font-size: clamp(24px, 2.6vw, 36px); line-height: 1.8; letter-spacing: 0.1em">{{ service.contact_1 }}<br>{{ service.contact_2 }}</p>
</div>
<div style="flex: 1 1 280px; display: flex; flex-direction: column; gap: 16px; font-size: 13px">
<a class="m-ul" href="{{ settings.contact_url or ('mailto:' + settings.email) }}" style="letter-spacing: 0.14em; padding: 6px 0; align-self: flex-start">Contact form →</a>
<a class="m-ul" href="mailto:{{ settings.email }}" style="letter-spacing: 0.08em; padding: 6px 0; align-self: flex-start">{{ settings.email }}</a>
</div>
</div>
</section>
