{#- expects: post, showExcerpt, cardClass, titleSize -#}
<a class="{{ cardClass or 'm-card' }}" data-cur="view" data-cats="{{ post.data.category | slugcat }}" href="{{ post.url }}" style="text-decoration: none; display: flex; flex-direction: column; gap: {{ 16 if showExcerpt else 14 }}px">
{%- if post.data.cover %}
<div class="m-im" style="aspect-ratio: 3 / 2; background: #E3F1F8; overflow: hidden"><img src="{{ post.data.cover }}" alt="" loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover; display: block"></div>
{%- else %}
<div class="m-im wv soft" style="aspect-ratio: 3 / 2" aria-hidden="true"></div>
{%- endif %}
<div style="display: flex; gap: 16px; font-size: 11px; letter-spacing: 0.12em; color: #4E6B78"><span>{{ post.date | ym }}</span><span>{{ post.data.category }}</span></div>
<span style="font-family: 'Noto Serif TC', serif; font-size: {{ titleSize or 18 }}px; line-height: 1.8; letter-spacing: 0.08em">{{ post.data.title }}</span>
{%- if showExcerpt and post.data.excerpt %}
<p style="margin: 0; font-size: 12px; line-height: 2; color: #4E6B78">{{ post.data.excerpt }}</p>
{%- endif %}
</a>
