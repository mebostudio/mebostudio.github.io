<!-- PROCESS (shared by About and Service) -->
<section id="process" style="max-width: 1440px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 56px) 160px">
<div class="rv" style="position: relative; display: flex; flex-wrap: wrap; gap: 32px 40px; padding-top: 24px">
<div class="m-ln" style="position: absolute; top: 0; left: 0; right: 0; height: 1px; background: #CFE2EA"></div>
<div style="flex: 1 1 240px; display: flex; flex-direction: column; gap: 2px">
<h2 style="margin: 0; font-size: 12px; font-weight: 500; letter-spacing: 0.16em">PROCESS</h2>
<span style="font-size: 12px; color: #4E6B78">合作流程</span>
</div>
<div style="flex: 3 1 560px; min-width: 0">
{%- if process.intro %}
<p style="margin: 0 0 56px; font-size: 14px; line-height: 2.2; color: #2F4B58">{{ process.intro }}</p>
{%- endif %}
<ol class="m-steps" style="position: relative; margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: 40px 24px">
{%- for st in process.steps %}
<li style="position: relative; display: flex; flex-direction: column; gap: 14px">
<div style="display: flex; align-items: center; gap: 12px">
<span class="m-node" aria-hidden="true">{{ loop.index | pad2 }}</span>
{%- if not loop.last %}<span class="m-ln m-step-ln" aria-hidden="true" style="flex: 1; height: 1px; background: #12303F; opacity: .35"></span>{% endif %}
</div>
<div style="display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap">
<span style="font-size: clamp(18px, 1.6vw, 22px); font-weight: 300; letter-spacing: 0.08em">{{ st.en }}</span>
{%- if st.zh %}<span style="font-size: 12px; color: #4E6B78">{{ st.zh }}</span>{% endif %}
</div>
<p style="margin: 0; font-size: 13px; line-height: 2; color: #2F4B58; max-width: 260px">{{ st.desc }}</p>
</li>
{%- endfor %}
</ol>
</div>
</div>
</section>
