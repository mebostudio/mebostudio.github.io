<!-- CONTACT -->
<section id="contact" class="wv">
<div class="rv" style="max-width: 1440px; margin: 0 auto; padding: 160px clamp(20px, 4vw, 56px) 160px; display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-end; justify-content: space-between">
<div style="flex: 3 1 560px; min-width: 0">
<div style="font-size: 11px; letter-spacing: 0.16em; color: #23404D; margin-bottom: 32px">CONTACT ／ 聯絡</div>
<p style="margin: 0; font-family: 'Noto Serif TC', serif; font-size: clamp(26px, 3vw, 42px); line-height: 1.7; letter-spacing: 0.1em">{{ home.contact_1 }}<br>{{ home.contact_2 }}</p>
</div>
<div style="flex: 1 1 280px; display: flex; flex-direction: column; gap: 16px; font-size: 13px">
<a class="m-ul" href="{{ settings.contact_url or ('mailto:' + settings.email) }}" style="letter-spacing: 0.14em; padding: 6px 0; align-self: flex-start">Contact form →</a>
<a class="m-ul" href="mailto:{{ settings.email }}" style="letter-spacing: 0.08em; padding: 6px 0; align-self: flex-start">{{ settings.email }}</a>
<a class="m-ul" href="{{ settings.instagram_url }}" style="letter-spacing: 0.08em; padding: 6px 0; align-self: flex-start">Instagram {{ settings.instagram_handle }} ↗</a>
</div>
</div>
</section>
