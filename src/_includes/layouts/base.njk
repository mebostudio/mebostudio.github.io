{%- set css = {
  "front": ["front"], "about": ["about"], "service": ["service"],
  "project": ["project"], "projects": ["project", "projects"],
  "journal": ["journal"], "post": ["post"]
} -%}
{%- set reveal = {
  "project": ".rv, .m-project > :not(.m-gallery), .m-gallery > *", "journal": ".rv, .m-card", "post": ".rv, .m-body > *"
} -%}
{%- set v = view or "post" -%}
{%- set fullTitle = (title + " — " + settings.site_title) if title else settings.site_title -%}
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ fullTitle }}</title>
<meta name="description" content="{{ excerpt or settings.description }}">
<meta property="og:title" content="{{ fullTitle }}">
<meta property="og:description" content="{{ excerpt or settings.description }}">
<meta property="og:type" content="website">
{%- if cover %}<meta property="og:image" content="{{ cover }}">{% endif %}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2312303F'/%3E%3Cpath d='M14 44V20h6l12 15 12-15h6v24h-6V30L32 45 20 30v14z' fill='%23BEE4F7'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300;400;500;600&family=Noto+Sans+TC:wght@300;400;500&family=Noto+Serif+TC:wght@400;500&display=swap">
<link rel="stylesheet" href="/assets/css/base.css">
{%- for c in css[v] %}
<link rel="stylesheet" href="/assets/css/{{ c }}.css">
{%- endfor %}
</head>
<body class="mebo-{{ v }}" data-reveal="{{ reveal[v] or '.rv, .m-ln, .wd, .m-gal > *' }}">
<a class="screen-reader-text m-skip" href="#main">跳至內容</a>
<div class="m-site">
<div class="prog" aria-hidden="true"></div>
<div class="cur" aria-hidden="true"><span>{{ "READ" if v in ["journal", "post"] else "VIEW" }}</span></div>
{% include "partials/header.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
</div>
<script src="/assets/js/mebo.js" defer></script>
</body>
</html>
